{
  "info": {
    "name": "Nest API",
    "description": "Nest personal finance API. Select the 'Nest Local' environment and run the folders in order. Folders are added as each Sprint 1 increment is completed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Authentication",
      "description": "Public endpoints. Run in order: the register request creates a fresh user (unique email) that later requests reuse.",
      "item": [
        {
          "name": "Register \u2014 success",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"preferredCurrency\": \"CAD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Unique, fake address so the collection can run repeatedly against the same database.",
                  "pm.environment.set('testEmail', `nest.user.${Date.now()}@example.test`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Location points to the profile', () => pm.expect(pm.response.headers.get('Location')).to.eql('/api/users/me'));",
                  "const b = pm.response.json();",
                  "pm.test('Returns the user with a normalised email', () => {",
                  "  pm.expect(b.id).to.be.a('number');",
                  "  pm.expect(b.email).to.eql(pm.environment.get('testEmail').toLowerCase());",
                  "  pm.expect(b.preferredCurrency).to.eql('CAD');",
                  "});",
                  "pm.test('Never exposes the password or its hash', () => {",
                  "  pm.expect(b).to.not.have.property('password');",
                  "  pm.expect(b).to.not.have.property('passwordHash');",
                  "  pm.expect(pm.response.text()).to.not.include(pm.environment.get('testPassword'));",
                  "});",
                  "pm.environment.set('userId', b.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register \u2014 duplicate email (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Same email as the previous request, in upper case. Email uniqueness is case-insensitive.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\",\n  \"email\": \"{{testEmailUpper}}\",\n  \"password\": \"{{testPassword}}\",\n  \"preferredCurrency\": \"CAD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('testEmailUpper', pm.environment.get('testEmail').toUpperCase());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('RFC 7807 problem body', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.status).to.eql(409);",
                  "  pm.expect(b).to.have.property('title');",
                  "  pm.expect(b).to.have.property('timestamp');",
                  "  pm.expect(b).to.not.have.property('trace');",
                  "});",
                  "pm.test('Explains the conflict', () => pm.expect(pm.response.json().detail).to.include('already exists'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register \u2014 invalid input (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"\",\n  \"lastName\": \"User\",\n  \"email\": \"not-an-email\",\n  \"password\": \"short\",\n  \"preferredCurrency\": \"XYZ\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('RFC 7807 problem body', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.status).to.eql(400);",
                  "  pm.expect(b).to.have.property('title');",
                  "  pm.expect(b).to.have.property('timestamp');",
                  "  pm.expect(b).to.not.have.property('trace');",
                  "});",
                  "pm.test('Lists every invalid field', () => {",
                  "  const fields = pm.response.json().errors.map(e => e.field);",
                  "  pm.expect(fields).to.include.members(['firstName', 'email', 'password', 'preferredCurrency']);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login \u2014 success",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('Returns a bearer JWT with expiry', () => {",
                  "  pm.expect(b.tokenType).to.eql('Bearer');",
                  "  pm.expect(b.accessToken.split('.')).to.have.lengthOf(3);",
                  "  pm.expect(new Date(b.expiresAt).getTime()).to.be.above(Date.now());",
                  "  pm.expect(b.user.email).to.eql(pm.environment.get('testEmail').toLowerCase());",
                  "});",
                  "pm.environment.set('authToken', b.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login \u2014 wrong password (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"Wr0ngPassword\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('RFC 7807 problem body', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.status).to.eql(401);",
                  "  pm.expect(b).to.have.property('title');",
                  "  pm.expect(b).to.have.property('timestamp');",
                  "  pm.expect(b).to.not.have.property('trace');",
                  "});",
                  "pm.test('Generic message', () => pm.expect(pm.response.json().detail).to.eql('Invalid email or password.'));",
                  "pm.test('No token issued', () => pm.expect(pm.response.json()).to.not.have.property('accessToken'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login \u2014 unknown email (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Must be indistinguishable from a wrong password, so attackers cannot discover registered emails.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nobody.{{$timestamp}}@example.test\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('RFC 7807 problem body', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.status).to.eql(401);",
                  "  pm.expect(b).to.have.property('title');",
                  "  pm.expect(b).to.have.property('timestamp');",
                  "  pm.expect(b).to.not.have.property('trace');",
                  "});",
                  "pm.test('Same generic message as wrong password', () => pm.expect(pm.response.json().detail).to.eql('Invalid email or password.'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "description": "Requires the token saved by 'Login \u2014 success'. The user is always taken from the token, never from the URL or body.",
      "item": [
        {
          "name": "Get my profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('Profile of the token owner', () => {",
                  "  pm.expect(b.id).to.eql(pm.environment.get('userId'));",
                  "  pm.expect(b.email).to.eql(pm.environment.get('testEmail').toLowerCase());",
                  "  pm.expect(b).to.not.have.property('passwordHash');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update my profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Updated\",\n  \"lastName\": \"Name\",\n  \"preferredCurrency\": \"EUR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('Changes are applied', () => {",
                  "  pm.expect(b.firstName).to.eql('Updated');",
                  "  pm.expect(b.preferredCurrency).to.eql('EUR');",
                  "  pm.expect(new Date(b.updatedAt).getTime()).to.be.at.least(new Date(b.createdAt).getTime());",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update my profile \u2014 invalid (400)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \" \",\n  \"lastName\": \"Name\",\n  \"preferredCurrency\": \"eur\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('RFC 7807 problem body', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.status).to.eql(400);",
                  "  pm.expect(b).to.have.property('title');",
                  "  pm.expect(b).to.have.property('timestamp');",
                  "  pm.expect(b).to.not.have.property('trace');",
                  "});",
                  "pm.test('Reports both invalid fields', () => {",
                  "  const fields = pm.response.json().errors.map(e => e.field);",
                  "  pm.expect(fields).to.include.members(['firstName', 'preferredCurrency']);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get my profile \u2014 no token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('RFC 7807 problem body', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.status).to.eql(401);",
                  "  pm.expect(b).to.have.property('title');",
                  "  pm.expect(b).to.have.property('timestamp');",
                  "  pm.expect(b).to.not.have.property('trace');",
                  "});",
                  "pm.test('Challenges for a bearer token', () => pm.expect(pm.response.headers.get('WWW-Authenticate')).to.include('Bearer'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get my profile \u2014 invalid token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "not.a.valid-token",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('RFC 7807 problem body', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.status).to.eql(401);",
                  "  pm.expect(b).to.have.property('title');",
                  "  pm.expect(b).to.have.property('timestamp');",
                  "  pm.expect(b).to.not.have.property('trace');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
