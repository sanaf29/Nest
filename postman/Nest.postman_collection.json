            "description": "No currency given: the user's preferred currency is used. A negative balance on a credit card is the amount owed.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Visa {{$timestamp}}\",\n  \"accountType\": \"CREDIT_CARD\",\n  \"openingBalance\": -250.4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('Uses preferred currency (EUR after the profile update)', () => pm.expect(b.currency).to.eql('EUR'));",
                  "pm.test('Debt is negative', () => pm.expect(b.currentBalance).to.eql(-250.4));",
                  "pm.environment.set('creditCardId', b.id);"
                ]
              }
            }
          ]
