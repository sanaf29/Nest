    {
      "name": "Accounts",
      "description": "Requires a token from 'Login \u2014 success'. Balances are derived, never set directly. DELETE closes (deactivates) an account.",
      "item": [
        {
          "name": "Create account \u2014 checking (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Everyday Chequing {{$timestamp}}\",\n  \"accountType\": \"CHECKING\",\n  \"currency\": \"CAD\",\n  \"openingBalance\": 1500.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('Location header', () => pm.expect(pm.response.headers.get('Location')).to.eql(`/api/accounts/${b.id}`));",
                  "pm.test('Balance derived from opening balance', () => {",
                  "  pm.expect(b.openingBalance).to.eql(1500);",
                  "  pm.expect(b.currentBalance).to.eql(1500);",
                  "  pm.expect(b.active).to.be.true;",
                  "});",
                  "pm.environment.set('accountId', b.id);",
                  "pm.environment.set('accountName', b.name);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create account \u2014 credit card, default currency (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
