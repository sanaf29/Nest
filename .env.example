# Copy to `.env` (git-ignored) and fill in real values.
# Read by docker compose and by the Spring Boot `dev` profile.

# SQL Server SA password: ≥ 8 chars with upper, lower, digit, and symbol (SQL Server policy).
NEST_DB_PASSWORD=ChangeMe_Str0ng!
NEST_DB_HOST=localhost
NEST_DB_PORT=1433
NEST_DB_NAME=nest
NEST_DB_USERNAME=sa

# Base64-encoded HMAC key, at least 32 bytes. Generate with:  openssl rand -base64 32
NEST_JWT_SECRET=

# Comma-separated origins allowed to call the API (the Vite dev server in Sprint 2).
NEST_CORS_ALLOWED_ORIGINS=http://localhost:5173
